# Application
APP_PORT=3000
# Origines CORS autorisées, séparées par des virgules (défaut : localhost:3001 et :8081)
FRONTEND_URL=http://localhost:3001,http://localhost:8081

# PostgreSQL / PostGIS (port 5434 : 5432/5433 souvent pris par d'autres projets)
DB_HOST=localhost
DB_PORT=5434
DB_USER=halholiday
DB_PASSWORD=change-me
DB_NAME=halholiday

# JWT — en production, générer un secret long et aléatoire (ex. `openssl rand -base64 48`)
JWT_SECRET=change-me-in-production-use-a-long-random-string
# Durée de vie du jeton d'accès (le refresh token prend le relais)
JWT_EXPIRES_IN=15m

# Compte admin (npm run seed:admin). Si l'email existe déjà, il est promu admin
# sans changer son mot de passe ; le password ne sert que si le compte n'existe pas.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
